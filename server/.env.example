# ─── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the site (used in emails, canonical URLs, sitemap). No trailing slash.
# Development: the Vite dev server. Production: https://your-domain.com
APP_URL=http://localhost:5173

# ─── Database (PostgreSQL 13+) ────────────────────────────────────────
# Local Docker:  postgres://marketplace:marketplace@localhost:5432/marketplace
# Supabase:      Project Settings → Database → Connection string (URI), use the "Session" pooler
# Neon:          Dashboard → Connection string
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace
# Set to true for hosted databases that require SSL (Supabase, Neon, RDS…)
DATABASE_SSL=false
# Run migrations + seed automatically on server start (handy for simple hosting)
AUTO_MIGRATE=false

# ─── First administrator (created by `npm run seed` if it doesn't exist) ─
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123
ADMIN_NAME=Site Administrator

# ─── Sessions & proxy ─────────────────────────────────────────────────
SESSION_DAYS=14
# true when running behind a reverse proxy / load balancer (Render, Railway, Nginx…)
TRUST_PROXY=false

# ─── Email (SMTP) — leave SMTP_HOST empty to print emails to the console ─
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SaudaGo <no-reply@your-domain.com>"

# ─── File storage ─────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_PUBLIC_DIR=storage/public
UPLOAD_PRIVATE_DIR=storage/private
MAX_IMAGE_MB=8

# ─── Online payments (optional) — manual bank transfer always works ───
# none | stripe
PAYMENT_GATEWAY=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── CAPTCHA (optional, Cloudflare Turnstile) ─────────────────────────
# Also set VITE_TURNSTILE_SITE_KEY in client/.env
TURNSTILE_SECRET_KEY=

# ─── Development & testing only — never enable in production ──────────
DEV_OUTBOX=false
RATE_LIMIT_RELAXED=false
DISABLE_JOBS=false
