{
  "name": "marketplace-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "esbuild src/index.ts src/migrate.ts src/seed.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist --sourcemap",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test:workflows": "tsx tests/workflows.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:prod": "node dist/migrate.js",
    "seed:prod": "node dist/seed.js",
    "dev:test": "cross-env DEV_OUTBOX=true RATE_LIMIT_RELAXED=true tsx src/index.ts",
    "db": "node scripts/localdb.mjs"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.10",
    "cross-env": "^7.0.3",
    "embedded-postgres": "^17.6.0-beta.15",
    "esbuild": "^0.24.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
